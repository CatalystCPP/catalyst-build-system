#compdef catalyst

_catalyst() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '1: :->cmds' \
        '*:: :->args'

    case $state in
        cmds)
            local -a subcommands
            subcommands=(
                'add:add a dependency'
                'bench:execute benchmarks'
                'build:build the project'
                'clean:clean artifacts'
                'doc:build documentation'
                'download:install a configured package from git'
                'fetch:fetch dependencies'
                'fmt:format source files'
                'generate:generate a build file'
                'ide-sync:sync IDE configuration files'
                'init:initialize a profile'
                'install:install the build artifacts'
                'lock:resolve and pin dependencies'
                'pack:assemble the local package for distribution'
                'profile-ls:list all profiles'
                'run:run a built executable'
                'test:run the test executable'
                'tidy:run linting'
            )
            _describe -t commands 'catalyst command' subcommands
            ;;
        args)
            case $line[1] in
                add)
                    _catalyst_add
                    ;;
                bench)
                    _catalyst_bench
                    ;;
                build)
                    _catalyst_build
                    ;;
                clean)
                    _catalyst_clean
                    ;;
                doc)
                    _catalyst_doc
                    ;;
                download)
                    _catalyst_download
                    ;;
                fetch)
                    _catalyst_fetch
                    ;;
                fmt)
                    # no flags
                    ;;
                generate)
                    _catalyst_generate
                    ;;
                ide-sync)
                    _catalyst_ide_sync
                    ;;
                init)
                    _catalyst_init
                    ;;
                install)
                    _catalyst_install
                    ;;
                lock)
                    _catalyst_lock
                    ;;
                pack)
                    _catalyst_pack
                    ;;
                profile-ls)
                    _catalyst_profile_ls
                    ;;
                run)
                    _catalyst_run
                    ;;
                test)
                    _catalyst_test
                    ;;
                tidy)
                    _catalyst_tidy
                    ;;
            esac
            ;;
    esac
}

_catalyst_profiles() {
    local -a profiles
    profiles=(${(f)"$(catalyst profile-ls 2>/dev/null)"})
    _describe -t profiles 'profiles' profiles
}

_catalyst_add() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '1: :->cmds' \
        '*:: :->args'

    case $state in
        cmds)
            local -a add_subcommands
            add_subcommands=(
                'git:add a remote git dependency'
                'local:add a local dependency'
                'system:add a system dependency'
                'vcpkg:add a vcpkg dependency'
            )
            _describe -t commands 'add subcommand' add_subcommands
            ;;
        args)
            case $line[1] in
                git)
                    _arguments \
                        '(-n --name)'{-n,--name}'[name]:name:' \
                        '(-v --version)'{-v,--version}'[version]:version:' \
                        '(-f --features)'{-f,--features}'[features]:features:' \
                        '*'{-p,--profiles}'[profiles]:*:profiles:_catalyst_profiles' \
                        '1:remote:'
                    ;;
                local)
                    _arguments \
                        '(-f --features)'{-f,--features}'[features]:features:' \
                        '*'{-p,--profiles}'[profiles]:*:profiles:_catalyst_profiles' \
                        '1:name:' \
                        '2:path:_directories'
                    ;;
                system)
                    _arguments \
                        '(-l --lib)'{-l,--lib}'[lib]:lib:' \
                        '(-i --inc)'{-i,--inc}'[inc]:inc:' \
                        '*'{-p,--profiles}'[profiles]:*:profiles:_catalyst_profiles' \
                        '1:name:'
                    ;;
                vcpkg)
                    _arguments \
                        '(-t --triplet)'{-t,--triplet}'[triplet]:triplet:' \
                        '(-v --version)'{-v,--version}'[version]:version:' \
                        '(-f --features)'{-f,--features}'[features]:features:' \
                        '*'{-p,--profiles}'[profiles]:*:profiles:_catalyst_profiles' \
                        '1:name:'
                    ;;
            esac
            ;;
    esac
}

_catalyst_bench() {
    _arguments \
        '(-P --params)'{-P,--params}'[params]:params:'
}

_catalyst_build() {
    _arguments \
        '(-r --regen)'{-r,--regen}'[regenerate the build file]' \
        '(-b --force-rebuild)'{-b,--force-rebuild}'[recompile dependencies]' \
        '--force-refetch[refetch dependencies]' \
        '(--workspace --all)'{--workspace,--all}'[build all members in the workspace]' \
        '(-P --package)'{-P,--package}'[package]:package:' \
        '*'{-p,--profiles}'[profiles]:*:profiles:_catalyst_profiles' \
        '(-f --features)'{-f,--features}'[features]:features:' \
        '--backend[backend]:backend:(ninja gmake cbe)' \
        '(-w --watch)'{-w,--watch}'[watch for file changes and rebuild]'
}

_catalyst_clean() {
    _arguments \
        '*'{-p,--profile}'[profile]:*:profile:_catalyst_profiles'
}

_catalyst_doc() {
    _arguments \
        '(-e --engine)'{-e,--engine}'[engine]:engine:(doxygen clang-doc jocasta)' \
        '--open[open documentation in browser]' \
        '--clean[clean output directory before generation]'
}

_catalyst_download() {
    _arguments \
        '*'{-p,--profiles}'[profiles]:*:profiles:_catalyst_profiles' \
        '(-f --features)'{-f,--features}'[features]:features:' \
        '(-t --target)'{-t,--target}'[target]:target:_directories' \
        '1:remote:' \
        '2:branch:'
}

_catalyst_fetch() {
    _arguments \
        '*'{-p,--profiles}'[profiles]:*:profiles:_catalyst_profiles'
}

_catalyst_generate() {
    _arguments \
        '*'{-p,--profiles}'[profiles]:*:profiles:_catalyst_profiles' \
        '(-f --features)'{-f,--features}'[features]:features:' \
        '(-b --backend)'{-b,--backend}'[backend]:backend:(ninja gmake cbe)'
}

_catalyst_ide_sync() {
    _arguments \
        '*'{-p,--profiles}'[profiles]:*:profiles:_catalyst_profiles' \
        '--ides[ides]:ides:(vscode clion)' \
        '(-f --force-ide)'{-f,--force-ide}'[force emitting IDE config]'
}

_catalyst_init() {
    _arguments \
        '(-n --name)'{-n,--name}'[name]:name:' \
        '--path[path]:path:_directories' \
        '(-t --type)'{-t,--type}'[type]:type:(binary staticlib sharedlib interface)' \
        '(-v --version)'{-v,--version}'[version]:version:' \
        '(-d --description)'{-d,--description}'[description]:description:' \
        '--provides[provides]:provides:' \
        '--cc[c compiler]:c_compiler:_command_names -e' \
        '--cxx[cxx compiler]:cxx_compiler:_command_names -e' \
        '--ccflags[c compiler flags]:c_compiler_flags:' \
        '--cxxflags[cxx compiler flags]:cxx_compiler_flags:' \
        '--ldflags[linker flags]:linker_flags:' \
        '--include-dirs[include dirs]:include_dirs:_directories' \
        '--source-dirs[source dirs]:source_dirs:_directories' \
        '--build-dir[build dir]:build_dir:_directories' \
        '--ides[ides]:ides:(vscode clion)' \
        '*'{-p,--profile}'[profile]:*:profile:_catalyst_profiles' \
        '(-f --force-ide)'{-f,--force-ide}'[force emitting IDE config]'
}

_catalyst_install() {
    _arguments \
        '*'{-p,--profiles}'[profiles]:*:profiles:_catalyst_profiles' \
        '(-s --source)'{-s,--source}'[source]:source:_directories' \
        '(-t --target)'{-t,--target}'[target]:target:_directories'
}

_catalyst_lock() {
    _arguments \
        '*'{-p,--profiles}'[profiles]:*:profiles:_catalyst_profiles'
}

_catalyst_pack() {
    _arguments \
        '*'{-p,--profiles}'[profiles]:*:profiles:_catalyst_profiles' \
        '(-s --source)'{-s,--source}'[source]:source:_directories' \
        '(-t --target)'{-t,--target}'[target]:target:_directories' \
        '(-G --generators)'{-G,--generators}'[generators]:generators:(TGZ ZIP DEB RPM NSIS WIX DMG STGZ FREEBSD APK 7Z TXZ EXTERNAL)'
}

_catalyst_profile_ls() {
    # no flags
}

_catalyst_run() {
    _arguments \
        '*'{-p,--profile}'[profile]:*:profile:_catalyst_profiles' \
        '(-P --params)'{-P,--params}'[params]:params:' \
        '*:target:'
}

_catalyst_test() {
    _arguments \
        '(-P --params)'{-P,--params}'[params]:params:' \
        '*:test:'
}

_catalyst_tidy() {
    _arguments \
        '*'{-p,--profiles}'[profiles]:*:profiles:_catalyst_profiles' \
        '--fix[automatically fix lint warnings]'
}

_catalyst "$@"