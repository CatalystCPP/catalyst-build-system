#!/bin/bash

_catalyst() {
    local cur prev words cword
    _init_completion || return

    local subcommands="add bench build clean doc download feature-ls fetch fmt generate help ide-sync init install lock pack profile-ls run test tidy"

    if [[ $cword -eq 1 ]]; then
        if [[ "$cur" == -* ]]; then
            COMPREPLY=($(compgen -W "-h --help -v --version -V --verbose" -- "$cur"))
        else
            COMPREPLY=($(compgen -W "$subcommands" -- "$cur"))
        fi
        return
    fi

    local last_flag=""
    for (( i=1; i<cword; i++ )); do
        if [[ "${words[i]}" == -* ]]; then
            last_flag="${words[i]}"
        fi
    done

    if [[ "$cur" != -* ]]; then
        case "$last_flag" in
            -p|--profile|--profiles)
                COMPREPLY=($(compgen -W "$(catalyst profile-ls 2>/dev/null)" -- "$cur"))
                return
                ;;
            -f|--feature|--features)
                COMPREPLY=($(compgen -W "$(catalyst feature-ls --inverse 2>/dev/null)" -- "$cur"))
                return
                ;;
            --ides)
                COMPREPLY=($(compgen -W "vscode clion" -- "$cur"))
                return
                ;;
            -G|--generators)
                COMPREPLY=($(compgen -W "7Z APK DEB DMG EXTERNAL FREEBSD NSIS RPM STGZ TGZ TXZ WIX ZIP" -- "$cur"))
                return
                ;;
        esac
    fi

    case "$prev" in
        -b|--backend)
            COMPREPLY=($(compgen -W "ninja gmake cbe" -- "$cur"))
            return
            ;;
        -e|--engine)
            COMPREPLY=($(compgen -W "doxygen clang-doc jocasta" -- "$cur"))
            return
            ;;
        -t|--type)
            if [[ "${words[1]}" == "init" ]]; then
                COMPREPLY=($(compgen -W "binary staticlib sharedlib interface" -- "$cur"))
                return
            fi
            ;;
    esac

    local subcommand=${words[1]}

    case "$subcommand" in
        add)
            local add_subcommands="git local system vcpkg"
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=($(compgen -W "$add_subcommands -h --help" -- "$cur"))
                return
            fi
            local add_sub=${words[2]}
            case "$add_sub" in
                git)
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=($(compgen -W "-h --help -n --name -v --version -f --features -p --profiles" -- "$cur"))
                    fi
                    ;;
                local)
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=($(compgen -W "-h --help -p --profiles -f --features" -- "$cur"))
                    fi
                    ;;
                system)
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=($(compgen -W "-h --help -l --lib -i --inc -p --profiles" -- "$cur"))
                    fi
                    ;;
                vcpkg)
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=($(compgen -W "-h --help -t --triplet -v --version -p --profiles -f --features" -- "$cur"))
                    fi
                    ;;
            esac
            ;;
        bench)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -P --params" -- "$cur"))
            fi
            ;;
        build)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -r --regen -b --force-rebuild --force-refetch --workspace --all -w --watch -P --package -p --profiles -f --features --backend" -- "$cur"))
            fi
            ;;
        clean)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -p --profile" -- "$cur"))
            fi
            ;;
        doc)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -e --engine --open --clean" -- "$cur"))
            fi
            ;;
        download)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -p --profiles -f --features -t --target" -- "$cur"))
            fi
            ;;
        feature-ls)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help --inverse" -- "$cur"))
            fi
            ;;
        fetch)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -p --profiles" -- "$cur"))
            fi
            ;;
        fmt)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help" -- "$cur"))
            fi
            ;;
        generate)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -p --profiles -f --features -b --backend" -- "$cur"))
            fi
            ;;
        help)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "add bench build clean doc download feature-ls fetch fmt generate ide-sync init install lock pack profile-ls run test tidy" -- "$cur"))
            fi
            ;;
        ide-sync)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -p --profiles --ides -f --force-ide" -- "$cur"))
            fi
            ;;
        init)
            case "$prev" in
                --path|--include-dirs|--source-dirs|--build-dir)
                    _filedir -d
                    return
                    ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -n --name --path -t --type -v --version -d --description --provides --cc --cxx --ccflags --cxxflags --ldflags --include-dirs --source-dirs --build-dir --ides -p --profile -f --force-ide" -- "$cur"))
            fi
            ;;
        install)
            case "$prev" in
                -s|--source|-t|--target)
                    _filedir -d
                    return
                    ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -p --profiles -s --source -t --target" -- "$cur"))
            fi
            ;;
        lock)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -p --profiles" -- "$cur"))
            fi
            ;;
        pack)
            case "$prev" in
                -s|--source|-t|--target)
                    _filedir -d
                    return
                    ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -p --profiles -s --source -t --target -G --generators -a --all" -- "$cur"))
            fi
            ;;
        profile-ls)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help" -- "$cur"))
            fi
            ;;
        run)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -p --profile -P --params" -- "$cur"))
            fi
            ;;
        test)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -P --params" -- "$cur"))
            fi
            ;;
        tidy)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help -p --profiles --fix" -- "$cur"))
            fi
            ;;
    esac
}

complete -F _catalyst catalyst
