#!/bin/bash

_catalyst() {
    local cur prev words cword
    _init_completion || return

    local subcommands="add bench build clean doc download fetch fmt generate ide_sync init install lock pack profile-ls run test tidy"

    if [[ $cword -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$subcommands" -- "$cur"))
        return
    fi

    local subcommand=${words[1]}

    case "$subcommand" in
        add)
            local add_subcommands="git local system vcpkg"
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=($(compgen -W "$add_subcommands" -- "$cur"))
                return
            fi
            local add_sub=${words[2]}
            case "$add_sub" in
                git)
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=($(compgen -W "-n --name -v --version -f --features -p --profiles" -- "$cur"))
                    fi
                    ;;
                local)
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=($(compgen -W "-p --profiles -f --features" -- "$cur"))
                    fi
                    ;;
                system)
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=($(compgen -W "-l --lib -i --inc -p --profiles" -- "$cur"))
                    fi
                    ;;
                vcpkg)
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=($(compgen -W "-t --triplet -v --version -p --profiles -f --features" -- "$cur"))
                    fi
                    ;;
            esac
            ;;
        bench)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-P --params" -- "$cur"))
            fi
            ;;
        build)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-r --regen -b --force-rebuild --force-refetch --workspace --all -P --package -p --profiles -f --features --backend --watch -w" -- "$cur"))
            fi
            ;;
        clean)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-p --profile" -- "$cur"))
            fi
            ;;
        doc)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-e --engine --open --clean" -- "$cur"))
            fi
            ;;
        download)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-p --profiles -f --features -t --target" -- "$cur"))
            fi
            ;;
        fetch)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-p --profiles" -- "$cur"))
            fi
            ;;
        fmt)
            # no flags
            ;;
        generate)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-p --profiles -f --features -b --backend" -- "$cur"))
            fi
            ;;
        ide_sync)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-p --profiles --ides -f --force-ide" -- "$cur"))
            fi
            ;;
        init)
            case "$prev" in
                --path|--include-dirs|--source-dirs|--build-dir)
                    _filedir -d
                    return
                    ;;
                -t|--type)
                    COMPREPLY=($(compgen -W "library executable" -- "$cur"))
                    return
                    ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-n --name --path -t --type -v --version -d --description --provides --cc --cxx --ccflags --cxxflags --ldflags --include-dirs --source-dirs --build-dir --ides -p --profile --force-ide" -- "$cur"))
            fi
            ;;
        install)
            case "$prev" in
                -s|--source|-t|--target)
                    _filedir -d
                    return
                    ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-p --profiles -s --source -t --target" -- "$cur"))
            fi
            ;;
        lock)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-p --profiles" -- "$cur"))
            fi
            ;;
        pack)
            case "$prev" in
                -s|--source|-t|--target)
                    _filedir -d
                    return
                    ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-p --profiles -s --source -t --target -G --generators" -- "$cur"))
            fi
            ;;
        profile-ls)
            # no flags
            ;;
        run)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-p --profile -P --params" -- "$cur"))
            fi
            ;;
        test)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-P --params" -- "$cur"))
            fi
            ;;
        tidy)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-p --profiles --fix" -- "$cur"))
            fi
            ;;
    esac
}

complete -F _catalyst catalyst
