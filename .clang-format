# Based on the LLVM coding standards
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 120
AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: None
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: false
BinPackArguments: false
BinPackParameters: false
FixNamespaceComments: true
IncludeBlocks: Regroup
IndentCaseLabels: true
SortIncludes: true
IncludeCategories:
  - Regex:           '^<[a-z0-9_]+\.h>$'
    Priority:        1
  - Regex:           '^<sys/.*'
    Priority:        1
  - Regex:           '^<[a-z0-9_]+>$'
    Priority:        2
  - Regex:           '^<.*'
    Priority:        3
  - Regex:           '^("catalyst/.*"|<catalyst/.*>)'
    Priority:        4

# --- Added for Operator Chaining ---
# Forces a break before binary operators if the expression wraps.
BreakBeforeBinaryOperators: NonAssignment

# Aligns the operators vertically on subsequent lines.
# Options: Align (aligns operators), Don'tAlign (indents normally)
AlignOperands: Align

# The indentation width for wrapped lines (like long math expressions).
ConstructorInitializerIndentWidth: 4
ContinuationIndentWidth: 4
